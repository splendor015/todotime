# 生产环境必须设置。请使用至少 32 字节的随机值，不要提交到 Git。
JWT_SECRET=replace-with-a-long-random-string
TODOTIME_PUBLIC_URL=https://todotime.me

# 虾推啥（https://xtuis.cn/）微信公众号通知。
# token 只保存在服务器的 .env；不要提交到 Git。
XTUIS_TOKEN=
# 第一个 token 对应的 TodoTime 登录用户名。
XTUIS_USERNAME=
# 可选：与第一个用户共享通知的更多 token，多个时用英文逗号分隔。
XTUIS_TOKENS=
# 第二位 TodoTime 用户及其独立的虾推啥 token。
XTUIS_TOKEN_2=
XTUIS_USERNAME_2=
